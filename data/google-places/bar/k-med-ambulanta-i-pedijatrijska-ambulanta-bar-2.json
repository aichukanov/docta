    {
      "name": "places/ChIJq2ERcwB1ThMRmxfuKUAW7sA/reviews/Ci9DQUlRQUNvZENodHljRjlvT2tWNFFtdE5kVjkxUTJWbFFtRk1lalZITjJoMU5IYxAB",
      "relativePublishTimeDescription": "пре 7 месеци",
      "rating": 5,
      "text": {
        "text": "Преглед код педијатра је коштао 70 евра. Одлично је што могу да дођем са бебом. Они раде комплетан преглед и узимају мерења. Клиника је погодно смештена у центру града.",
        "languageCode": "sr"
      },
      "originalText": {
        "text": "Приём педиатра стоил 70 евро. Отлично, что можно прийти с грудничком. Делают полный осмотр, снимают показатели. Удобное расположение клиники в центре города.",
        "languageCode": "ru"
      },
      "authorAttribution": {
        "displayName": "Анна Ставрова",
        "uri": "https://www.google.com/maps/contrib/110062395535812623736/reviews",
        "photoUri": "https://lh3.googleusercontent.com/a-/ALV-UjXwXPmZ1nJ7IGAU5V91HGNismFMG26MTv_jGWbq7lpPkFBCMbhd=s128-c0x00000000-cc-rp-mo-ba6"
      },
      "publishTime": "2025-12-29T18:41:22.848073515Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2tWNFFtdE5kVjkxUTJWbFFtRk1lalZITjJoMU5IYxAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tWNFFtdE5kVjkxUTJWbFFtRk1lalZITjJoMU5IYxAB!2m1!1s0x134e7500731161ab:0xc0ee164029ee179b",
      "_collectedAt": "2026-10-29",
