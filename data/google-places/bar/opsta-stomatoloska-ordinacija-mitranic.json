      "name": "places/ChIJB0JfTwB0ThMRXHNR6Zb9OVU/reviews/Ci9DQUlRQUNvZENodHljRjlvT2pOdGVVdzVja3RaVjB4V04xVlZhbEZhZURoVVVtYxAB",
      "relativePublishTimeDescription": "пре 4 месеца",
      "rating": 5,
      "text": {
        "text": "Др Јанко је најбољи избор у Бару! Одличан доктор!\nЦела породица добија стоматолошке услуге. Рад је одличан, а цене су разумне.",
        "languageCode": "sr"
      },
      "originalText": {
        "text": "Доктор Янко — лучший выбор в Баре! Отличный доктор!\nЛечим зубы всей семьей. Работа великолепная, цены адекватные.",
        "languageCode": "ru"
      },
      "authorAttribution": {
        "displayName": "Тамара Амелина",
        "uri": "https://www.google.com/maps/contrib/100896489141866594951/reviews",
        "photoUri": "https://lh3.googleusercontent.com/a-/ALV-UjXkyG2miDWAFbTxgoJ5SxTIG7sqfZEIoJbFjHfT7DxfvEMlZ3vIdQ=s128-c0x00000000-cc-rp-mo"
      },
      "publishTime": "2026-03-19T17:28:06.722514481Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2pOdGVVdzVja3RaVjB4V04xVlZhbEZhZURoVVVtYxAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pOdGVVdzVja3RaVjB4V04xVlZhbEZhZURoVVVtYxAB!2m1!1s0x134e74004f5f4207:0x5539fd96e951735c",
