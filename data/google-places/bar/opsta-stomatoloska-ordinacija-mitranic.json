    {
      "name": "places/ChIJB0JfTwB0ThMRXHNR6Zb9OVU/reviews/Ci9DQUlRQUNvZENodHljRjlvT2taVU4yNVpRUzAxYlhGR01GOVZia1Z0ZDI4MVdXYxAB",
      "relativePublishTimeDescription": "пре годину дана",
      "rating": 5,
      "text": {
        "text": "Он је одличан доктор, спасао ми је неколико зуба, веома је темељан специјалиста и ради без журбе. Урадио ми је четири крунице и све изгледају као моји зуби. Било ми је од велике помоћи што др Јанко говори руски.",
        "languageCode": "sr"
      },
      "originalText": {
        "text": "Хороший доктор, спас мне несколько зубов, очень аккуратный специалист, работает без спешки. Делал у него 4 коронки, все стоят как родные зубы. Очень мне помогло то что доктор Янко знает русский язык.",
        "languageCode": "ru"
      },
      "authorAttribution": {
        "displayName": "Alex L",
        "uri": "https://www.google.com/maps/contrib/108835733253833768574/reviews",
        "photoUri": "https://lh3.googleusercontent.com/a/ACg8ocJCnOcjdOW1qHG5xO31MLJMDIYvFSJ-ziBCa5_sO6ctcgAxOw=s128-c0x00000000-cc-rp-mo"
      },
      "publishTime": "2025-07-30T16:22:34.679161744Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2taVU4yNVpRUzAxYlhGR01GOVZia1Z0ZDI4MVdXYxAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2taVU4yNVpRUzAxYlhGR01GOVZia1Z0ZDI4MVdXYxAB!2m1!1s0x134e74004f5f4207:0x5539fd96e951735c",
