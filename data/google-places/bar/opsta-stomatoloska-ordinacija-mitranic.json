    {
      "name": "places/ChIJB0JfTwB0ThMRXHNR6Zb9OVU/reviews/ChdDSUhNMG9nS0VJQ0FnSURRaU0yYjlRRRAB",
      "relativePublishTimeDescription": "пре 8 година",
      "rating": 5,
      "text": {
        "text": "Алекса је уживао и једва чека да поново посети докторку Тамару... Само речи хвале за Митраниц Дентал...",
        "languageCode": "sr"
      },
      "originalText": {
        "text": "Aleksa je uživao i jedva čeka da se opet vidi sa njegovom doktoricom Tamarom... Samo riječi hvale za Mitranic Dental...",
        "languageCode": "hr"
      },
      "authorAttribution": {
        "displayName": "Milutin Vujosevic",
        "uri": "https://www.google.com/maps/contrib/112242492314876794909/reviews",
        "photoUri": "https://lh3.googleusercontent.com/a-/ALV-UjWNJmawvDsP0dpAv_vQJFmEFANrVV39nxrccrXdqsSiOCt1QqCWMg=s128-c0x00000000-cc-rp-mo"
      },
      "publishTime": "2017-09-08T11:11:03.711Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChdDSUhNMG9nS0VJQ0FnSURRaU0yYjlRRRAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSURRaU0yYjlRRRAB!2m1!1s0x134e74004f5f4207:0x5539fd96e951735c",
      "_collectedAt": "2026-10-29",
      "_enrichedFromDump": "2026-10-29"
    },
    {
      "name": "places/ChIJB0JfTwB0ThMRXHNR6Zb9OVU/reviews/ChZDSUhNMG9nS0VJQ0FnSURSNFlfZldBEAE",
      "relativePublishTimeDescription": "пре 3 године",
      "rating": 5,
      "text": {
        "text": "Ја сам из Украјине и привремено живим у граду Бару. Када ми је фиксна протеза почела да се клати, обратио сам се поликлиници „Ординација опште стоматологије Митранић“.\nДоктор Јанко је професионално и савесно приступио решавању мог проблема: направио рендгенски снимак, пажљиво уклонио протезу, лечио и рестаурирао потпорне зубе, вратио протезу и вратио ми стари осмех и способност да нормално и правилно жвачем храну. .\nХвала др Јанку и његовој сестри Сенади на професионалности, љубазности и доброј атмосфери коју су ми пружили током лечења.",
        "languageCode": "sr"
      },
      "originalText": {
        "text": "Ja sam iz Ukrajine i privremeno živim u gradu Baru.  Kada mi se neskidiva proteza počela klimati obratila sam se poliklinici \"Opšta stomatološka ordinacija Mitranić\".\nDr. Janko je profesionalno i skrupulozno pristupio rješenju mog problema: napravio je rendgensku snimku, pažljivo skinuo protezu, izliječio i restaurirao potporne zube, vratio protezu i vratio mi stari osmijeh i sposobnost normalnog i pravilnog žvakanja hrane. .\nHvala dr. Janku i njegovoj sestri Senadi na profesionalnosti, ljubaznosti i dobroj atmosferi koju su mi pružili tijekom liječenja.",
        "languageCode": "bs"
      },
      "authorAttribution": {
        "displayName": "Yurhen Norton",
        "uri": "https://www.google.com/maps/contrib/103975585837000615672/reviews",
        "photoUri": "https://lh3.googleusercontent.com/a-/ALV-UjXy2iM69X7RVLebFujHgrPw_aKdFzojm1CZg2c2m7qEnBtKb_Xm=s128-c0x00000000-cc-rp-mo"
      },
      "publishTime": "2023-04-27T07:29:08.706170Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChZDSUhNMG9nS0VJQ0FnSURSNFlfZldBEAE&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSURSNFlfZldBEAE!2m1!1s0x134e74004f5f4207:0x5539fd96e951735c",
      "_collectedAt": "2026-10-29",
