    {
      "name": "reviews/Ci9DQUlRQUNvZENodHljRjlvT2s1TmRXUkVhRXcyVUdkSmVHMXBlRTAxZGt0VlNWRRAB",
      "relativePublishTimeDescription": "2 месяца назад",
      "rating": 5,
      "text": {
        "text": "Excellent experiences at this private ENT clinic in Bar for myself and my family! Dr. Gordana is incredibly professional, thorough, and genuinely caring. She takes the time for proper examination, explains everything clearly, and offers the most appropriate treatment plan that never fails. The Nurse is friendly and efficient, appointments are on time, and visits feel calm and reassuring rather than rushed. I would highly recommend this clinic to anyone in Bar looking for a skilled and attentive ENT specialist. Five stars, without hesitation!",
        "languageCode": "en"
      },
      "originalText": {
        "text": "Excellent experiences at this private ENT clinic in Bar for myself and my family! Dr. Gordana is incredibly professional, thorough, and genuinely caring. She takes the time for proper examination, explains everything clearly, and offers the most appropriate treatment plan that never fails. The Nurse is friendly and efficient, appointments are on time, and visits feel calm and reassuring rather than rushed. I would highly recommend this clinic to anyone in Bar looking for a skilled and attentive ENT specialist. Five stars, without hesitation!",
        "languageCode": "en"
      },
