      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xJMWRISkNkV0p0YkV4eU0yZHRlalYzYUdReVlXYxAB!2m1!1s0x134e740049260d5b:0xb8f2db96ef2f99a7",
