      "publishTime": "2022-09-10T15:56:42.136090Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChZDSUhNMG9nS0VJQ0FnSUNlOG9LZExnEAE&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUNlOG9LZExnEAE!2m1!1s0x135293c27359e01d:0x762b490dcb1e9b1e",
