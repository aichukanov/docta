      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUM3d056aWFnEAE!2m1!1s0x134dce5e3b39d7e3:0xb7818f579d094eb9",
      "_collectedAt": "2026-10-29",
