      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSUROM3RfbHVRRRAB!2m1!1s0x134c3c80c45461cd:0xad95bfb434b1b68",
