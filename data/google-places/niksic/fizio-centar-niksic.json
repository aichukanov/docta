      },
      "publishTime": "2026-03-13T16:01:13.639263260Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2tVMFdGRmhZMDlIV25acmQxVXdURXhyU2tWcWJGRRAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tVMFdGRmhZMDlIV25acmQxVXdURXhyU2tWcWJGRRAB!2m1!1s0x134da96d4b557c43:0xfd3d3ef0b61025aa",
