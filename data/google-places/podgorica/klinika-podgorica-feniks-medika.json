      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUNBbXFHYUR3EAE!2m1!1s0x134deb4eacc7241b:0xafbcbf7a97721d80",
