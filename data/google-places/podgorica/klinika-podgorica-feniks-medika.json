      },
      "publishTime": "2025-10-27T09:48:00.562087691Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT21waVRHSlZRbTFpWm14WFpVVXRRekI0ZEVaNFJHYxAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21waVRHSlZRbTFpWm14WFpVVXRRekI0ZEVaNFJHYxAB!2m1!1s0x134deb4eacc7241b:0xafbcbf7a97721d80",
