    },
    {
      "name": "places/ChIJARdxydjqTRMRs1L64zL89Gw/reviews/ChZDSUhNMG9nS0VJQ0FnSUNzN2VuOWVREAE",
      "relativePublishTimeDescription": "пре 6 година",
      "rating": 5,
      "text": {
        "text": "Веома љубазно особље, професионално и веома сарадљиво. Част је сарађивати са њима.",
        "languageCode": "sr"
      },
      "originalText": {
        "text": "Veoma ljubazno osoblje, profesionalci i veoma kooperativni. Čast mi je sarađivati sa njima.",
        "languageCode": "bs"
      },
