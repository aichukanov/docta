    {
      "name": "places/ChIJARdxydjqTRMRs1L64zL89Gw/reviews/ChdDSUhNMG9nS0VJQ0FnSURKaDZiNjF3RRAB",
      "relativePublishTimeDescription": "пре 2 године",
      "rating": 1,
      "text": {
        "text": "Хематолог Ћорац је изузетно непрофесионалан, безобразан и груб. Веома лош однос са пацијентима. Не бих је никако препоручио! Клоните је се! На крају крајева, ми плаћамо њене услуге да би се она тако катастрофално понашала према пацијентима.",
        "languageCode": "sr"
      },
      "originalText": {
        "text": "Hematolog Ćorac krajnje neprofesionalna, drska, bezobrazna. Jako loš odnos sa pacijentima. Nikako je ne bih preporučio! Što dalje od nje! Jer ipak njene usluge mi plaćamo da bi ona imala tako katastrofalno ponašanje prema pacijentima.",
        "languageCode": "bs"
      },
      "authorAttribution": {
        "displayName": "Nikola Stefanovic",
        "uri": "https://www.google.com/maps/contrib/116054394872453473409/reviews",
        "photoUri": "https://lh3.googleusercontent.com/a/ACg8ocK9i3YXpzXtbiwPIhsgNLrcA5WJCjCa1c3DLxoyIZy7rWwT5w=s128-c0x00000000-cc-rp-mo"
      },
      "publishTime": "2023-07-23T23:08:58.592334Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChdDSUhNMG9nS0VJQ0FnSURKaDZiNjF3RRAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSURKaDZiNjF3RRAB!2m1!1s0x134dead8c9711701:0x6cf4fc32e3fa52b3",
      "_collectedAt": "2026-10-29",
      "_enrichedFromDump": "2026-10-29",
