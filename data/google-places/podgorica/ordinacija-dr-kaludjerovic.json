      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2s5VE1HWlljMnBrUlVONVpYcHFVVzFNVTBoUWVWRRAB!2m1!1s0x134deb39fb7208b9:0xd66af8f3b228cbe",
