    {
      "name": "places/ChIJfaGYgC3rTRMRHWWeeXeO6Wo/reviews/Ci9DQUlRQUNvZENodHljRjlvT2xodFdYcERiR1pyU0VkeU5VeGtkakE0T1dOUVFYYxAB",
      "relativePublishTimeDescription": "пре 4 месеца",
      "rating": 5,
      "text": {
        "text": "Александар има магнет и ултразвук у рукама!!! Користећи искуство, знање, емпатију и посвећеност, савременим уређајима и техникама, опоравља тело у невероватно кратком року. Професионалност на завидном нивоу!\n\nСве препоруке 👌🏻",
        "languageCode": "sr"
      },
      "originalText": {
        "text": "Aleksandar ima magnet i ultrazvuk u rukama!!! Primjenom iskustva, znanja, empatije i posvećenosti, sa savremenim aparatima i tehnikama oporavlja tijelo u nevjerovatno kratkom periodu. Profesionalizam na zavidnom nivou!\n\nSve preporuke 👌🏻",
        "languageCode": "bs"
      },
      "authorAttribution": {
        "displayName": "A B",
        "uri": "https://www.google.com/maps/contrib/105026101099755818649/reviews",
        "photoUri": "https://lh3.googleusercontent.com/a/ACg8ocJFhBQ0G3lNE7ezGUHKBOgY8Qu9c06CW3M-bR099lgQvSYzag=s128-c0x00000000-cc-rp-mo"
      },
      "publishTime": "2025-11-11T10:36:56.257378760Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2xodFdYcERiR1pyU0VkeU5VeGtkakE0T1dOUVFYYxAB&d=17924085&t=1",
