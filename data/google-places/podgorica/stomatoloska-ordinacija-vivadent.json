  "reviews": [
    {
      "name": "places/ChIJW6ohrkDrTRMRp0sMhQl0oFc/reviews/ChdDSUhNMG9nS0VJQ0FnTURJb2FueXNnRRAB",
      "relativePublishTimeDescription": "пре 11 месеци",
      "rating": 5,
      "text": {
        "text": "Предиван тим стоматолога који ми је давањем стручних савета и упутстава излечио моју упалу десни. Урадио сам неколико пломби на зубима – што је било безболно уз занимљиве разговоре са стручњацима у ординацији. Моје поверење у ординацију Вивадент је потпуно оправдано. Мој осмех је блистав, зуби и десни су здрави, а сваки пут када дођем научим нешто ново. НЕЋУ МЕЊАМ СТОМАТОЛОШКУ ЦЕЛИНУ! Све похвале за професионалност и посвећеност!",
        "languageCode": "sr"
      },
      "originalText": {
        "text": "Divan tim stomatologa koji mi je davajuci strucne savjete i smjernice oporavio upalu desni. Radila sam par plombica na zubicima - sto je proteklo bezbolno uz zanimljive razgovore sa strucnim licima ordinacije. Moje povjerenje usmjereno ka Vivadent ordinaciji je potpuno opravdano. Osmjeh mi je blistav, zubi i desni zdrave, i pri svakom dolasku naucim nesto novo. Zubarku - NE MIJENJAM ! Sve pohvale za profesionalnost i posvecenost !",
        "languageCode": "bs"
      },
      "authorAttribution": {
        "displayName": "Talya Lilith Venera",
        "uri": "https://www.google.com/maps/contrib/113867620426386230084/reviews",
        "photoUri": "https://lh3.googleusercontent.com/a-/ALV-UjVM2tAECMWny1y-8joec6lbRIGsJiFLiW8vyHfW9DVKHY-rLvOZ=s128-c0x00000000-cc-rp-mo"
      },
      "publishTime": "2025-04-10T14:05:04.923141Z",
      "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChdDSUhNMG9nS0VJQ0FnTURJb2FueXNnRRAB&d=17924085&t=1",
      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnTURJb2FueXNnRRAB!2m1!1s0x134deb40ae21aa5b:0x57a07409850c4ba7",
