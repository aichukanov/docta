      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VPdW9vdnVnMk9LUkpBEAE!2m1!1s0x134c32288bc62817:0x4f4939d87aca0438",
